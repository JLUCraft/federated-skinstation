{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skin.jlucraft.com/contracts/operations",
  "title": "OperationsContracts",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "OperationsIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "OperationsAction": {
      "type": "string",
      "enum": ["start", "stop", "restart"]
    },
    "OperationsJobState": {
      "type": "string",
      "enum": ["queued", "running", "succeeded", "failed", "cancelled", "interrupted"]
    },
    "OperationsInstanceState": {
      "type": "string",
      "enum": ["stopped", "starting", "running", "stopping", "busy", "error"]
    },
    "OperationsActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "client", "request"],
      "properties": {
        "account": {
          "type": "string"
        },
        "client": {
          "type": ["string", "null"]
        },
        "request": {
          "type": "string"
        }
      }
    },
    "OperationsCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance", "operation"],
      "properties": {
        "instance": {
          "$ref": "#/definitions/OperationsIdentifier"
        },
        "operation": {
          "$ref": "#/definitions/OperationsOperation"
        }
      }
    },
    "OperationsIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actor", "command", "scope"],
      "properties": {
        "id": {
          "$ref": "#/definitions/OperationsIdentifier"
        },
        "actor": {
          "$ref": "#/definitions/OperationsActor"
        },
        "command": {
          "$ref": "#/definitions/OperationsCommand"
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "OperationsDispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "expiresAt"],
      "properties": {
        "intent": {
          "$ref": "#/definitions/OperationsIntent"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "OperationsJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "state", "createdAt", "updatedAt", "expiresAt"],
      "properties": {
        "intent": {
          "$ref": "#/definitions/OperationsIntent"
        },
        "state": {
          "$ref": "#/definitions/OperationsJobState"
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "string"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0
        },
        "cancelledBy": {
          "$ref": "#/definitions/OperationsActor"
        }
      }
    },
    "OperationsInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "pid", "acceptsConsole"],
      "properties": {
        "id": {
          "$ref": "#/definitions/OperationsIdentifier"
        },
        "state": {
          "$ref": "#/definitions/OperationsInstanceState"
        },
        "pid": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "acceptsConsole": {
          "type": "boolean"
        }
      }
    },
    "OperationsSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instances"],
      "properties": {
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OperationsInstance"
          }
        }
      }
    },
    "OperationsSubmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "operation"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operation": {
          "$ref": "#/definitions/OperationsOperation"
        }
      }
    },
    "OperationsTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "instance", "scope"],
      "properties": {
        "host": {
          "$ref": "#/definitions/OperationsIdentifier"
        },
        "instance": {
          "$ref": "#/definitions/OperationsIdentifier"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "OperationsTargetList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets"],
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OperationsTarget"
          }
        }
      }
    },
    "OperationsProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaseSeconds",
        "maxRequestBytes",
        "snapshotPath",
        "jobsPath",
        "controlPath",
        "instancesPath",
        "maxPageRows",
        "watchSeconds",
        "scopeHeader"
      ],
      "properties": {
        "leaseSeconds": {
          "const": 60
        },
        "maxRequestBytes": {
          "const": 65536
        },
        "snapshotPath": {
          "const": "/snapshot"
        },
        "jobsPath": {
          "const": "/jobs"
        },
        "controlPath": {
          "const": "/api/operations"
        },
        "instancesPath": {
          "const": "/instances"
        },
        "maxPageRows": {
          "const": 100
        },
        "watchSeconds": {
          "const": 10
        },
        "scopeHeader": {
          "const": "x-jlucraft-scope"
        }
      }
    },
    "OperationsHostSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "credentialEnv"],
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "credentialEnv": {
          "type": "string"
        }
      }
    },
    "OperationsSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts"],
      "properties": {
        "hosts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/OperationsHostSettings"
          }
        }
      }
    },
    "OperationsLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {
          "$ref": "#/definitions/OperationsAction"
        }
      }
    },
    "OperationsConsole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "input"],
      "properties": {
        "action": {
          "const": "console"
        },
        "input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\r\\n\\u0000]+$"
        }
      }
    },
    "OperationsOperation": {
      "oneOf": [
        {
          "$ref": "#/definitions/OperationsLifecycle"
        },
        {
          "$ref": "#/definitions/OperationsConsole"
        }
      ]
    },
    "OperationsCancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "expiresAt"],
      "properties": {
        "actor": {
          "$ref": "#/definitions/OperationsActor"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "OperationsJobPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobs", "cursor"],
      "properties": {
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OperationsJob"
          }
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/definitions/OperationsCursor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "OperationsLogRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "at", "data", "clipped"],
      "properties": {
        "sequence": {
          "$ref": "#/definitions/OperationsCursor"
        },
        "at": {
          "type": "integer",
          "minimum": 0
        },
        "data": {
          "type": "string"
        },
        "clipped": {
          "type": "boolean"
        }
      }
    },
    "OperationsLogPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "cursor", "truncated"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OperationsLogRecord"
          }
        },
        "cursor": {
          "$ref": "#/definitions/OperationsCursor"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "OperationsAlert": {
      "type": "string",
      "enum": [
        "process_stopped",
        "process_error",
        "log_storage_failed",
        "disk_pressure",
        "memory_pressure",
        "log_capture_loss"
      ]
    },
    "OperationsObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt",
        "uptimeSeconds",
        "instance",
        "cpuPercent",
        "memoryBytes",
        "diskTotalBytes",
        "diskAvailableBytes",
        "alerts"
      ],
      "properties": {
        "observedAt": {
          "type": "integer",
          "minimum": 0
        },
        "uptimeSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "instance": {
          "$ref": "#/definitions/OperationsInstance"
        },
        "cpuPercent": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "memoryBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "diskTotalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "diskAvailableBytes": {
          "type": "integer",
          "minimum": 0
        },
        "alerts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OperationsAlert"
          }
        }
      }
    },
    "OperationsCursor": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "OperationsPageQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "$ref": "#/definitions/OperationsCursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        }
      }
    }
  }
}
