{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "SessionProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "properties"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "properties": {
      "type": "array",
      "items": {
        "title": "ProfileProperty",
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "value"],
        "properties": {
          "name": { "type": "string" },
          "value": { "type": "string" },
          "signature": { "type": "string" }
        }
      }
    }
  }
}
