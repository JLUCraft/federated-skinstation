{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://skin.jlucraft.com/contracts/operations",
  "title": "OperationsContracts",
  "type": "object",
  "additionalProperties": false,
  "definitions": {
    "OperationsIdentifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "OperationsAction": {
      "type": "string",
      "enum": ["start", "stop", "restart"]
    },
    "OperationsJobState": {
      "type": "string",
      "enum": ["queued", "running", "succeeded", "failed", "cancelled", "interrupted"]
    },
    "OperationsInstanceState": {
      "type": "string",
      "enum": ["stopped", "starting", "running", "stopping", "busy", "error"]
    },
    "OperationsActor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "client", "request"],
      "properties": {
        "account": {
          "type": "string"
        },
        "client": {
          "type": ["string", "null"]
        },
        "request": {
          "type": "string"
        }
      }
    },
    "OperationsCommand": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instance", "operation"],
      "properties": {
        "instance": {
          "$ref": "#/definitions/OperationsIdentifier"
        },
        "operation": {
          "$ref": "#/definitions/OperationsOperation"
        }
      }
    },
    "OperationsIntent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "actor", "command", "scope"],
      "properties": {
        "id": {
          "$ref": "#/definitions/OperationsIdentifier"
        },
        "actor": {
          "$ref": "#/definitions/OperationsActor"
        },
        "command": {
          "$ref": "#/definitions/OperationsCommand"
        },
        "scope": {
          "type": "string"
        }
      }
    },
    "OperationsDispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "expiresAt"],
      "properties": {
        "intent": {
          "$ref": "#/definitions/OperationsIntent"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0
        },
        "approval": {
          "$ref": "#/definitions/OperationsHumanApproval"
        }
      }
    },
    "OperationsJob": {
      "type": "object",
      "additionalProperties": false,
      "required": ["intent", "state", "createdAt", "updatedAt", "expiresAt"],
      "properties": {
        "intent": {
          "$ref": "#/definitions/OperationsIntent"
        },
        "state": {
          "$ref": "#/definitions/OperationsJobState"
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        },
        "updatedAt": {
          "type": "integer",
          "minimum": 0
        },
        "error": {
          "type": "string"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0
        },
        "cancelledBy": {
          "$ref": "#/definitions/OperationsActor"
        },
        "approval": {
          "$ref": "#/definitions/OperationsHumanApproval"
        },
        "result": {
          "$ref": "#/definitions/OperationsResult"
        }
      }
    },
    "OperationsInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "state", "pid", "acceptsConsole"],
      "properties": {
        "id": {
          "$ref": "#/definitions/OperationsIdentifier"
        },
        "state": {
          "$ref": "#/definitions/OperationsInstanceState"
        },
        "pid": {
          "type": ["integer", "null"],
          "minimum": 0
        },
        "acceptsConsole": {
          "type": "boolean"
        }
      }
    },
    "OperationsSnapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["instances"],
      "properties": {
        "instances": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OperationsInstance"
          }
        }
      }
    },
    "OperationsSubmission": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "operation"],
      "properties": {
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "operation": {
          "$ref": "#/definitions/OperationsOperation"
        }
      }
    },
    "OperationsTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "instance", "scope"],
      "properties": {
        "host": {
          "$ref": "#/definitions/OperationsIdentifier"
        },
        "instance": {
          "$ref": "#/definitions/OperationsIdentifier"
        },
        "scope": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        }
      }
    },
    "OperationsTargetList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["targets"],
      "properties": {
        "targets": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OperationsTarget"
          }
        }
      }
    },
    "OperationsProtocol": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "leaseSeconds",
        "maxRequestBytes",
        "snapshotPath",
        "jobsPath",
        "controlPath",
        "instancesPath",
        "maxPageRows",
        "watchSeconds",
        "scopeHeader",
        "approvalSeconds",
        "claimPath",
        "claimHeader"
      ],
      "properties": {
        "leaseSeconds": {
          "const": 60
        },
        "maxRequestBytes": {
          "const": 65536
        },
        "snapshotPath": {
          "const": "/snapshot"
        },
        "jobsPath": {
          "const": "/jobs"
        },
        "controlPath": {
          "const": "/api/operations"
        },
        "instancesPath": {
          "const": "/instances"
        },
        "maxPageRows": {
          "const": 100
        },
        "watchSeconds": {
          "const": 10
        },
        "scopeHeader": {
          "const": "x-jlucraft-scope"
        },
        "approvalSeconds": {
          "const": 300
        },
        "claimPath": {
          "const": "/internal/operations"
        },
        "claimHeader": {
          "const": "x-jlucraft-executor"
        }
      }
    },
    "OperationsHostSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["endpoint", "credentialEnv"],
      "properties": {
        "endpoint": {
          "type": "string"
        },
        "credentialEnv": {
          "type": "string"
        }
      }
    },
    "OperationsSettings": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hosts"],
      "properties": {
        "hosts": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/definitions/OperationsHostSettings"
          }
        }
      }
    },
    "OperationsLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {
          "$ref": "#/definitions/OperationsAction"
        }
      }
    },
    "OperationsConsole": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "input"],
      "properties": {
        "action": {
          "enum": ["console"]
        },
        "input": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "^[^\\r\\n\\u0000]+$"
        }
      }
    },
    "OperationsOperation": {
      "oneOf": [
        {
          "$ref": "#/definitions/OperationsLifecycle"
        },
        {
          "$ref": "#/definitions/OperationsConsole"
        },
        {
          "$ref": "#/definitions/OperationsKill"
        },
        {
          "$ref": "#/definitions/OperationsRestore"
        },
        {
          "$ref": "#/definitions/OperationsBackupExport"
        },
        {
          "$ref": "#/definitions/OperationsBackupImport"
        },
        {
          "$ref": "#/definitions/OperationsBackupDelete"
        },
        {
          "$ref": "#/definitions/OperationsBackupCreate"
        },
        {
          "$ref": "#/definitions/OperationsRestorePrepare"
        },
        {
          "$ref": "#/definitions/OperationsProvision"
        },
        {
          "$ref": "#/definitions/OperationsDeployPrepare"
        },
        {
          "$ref": "#/definitions/OperationsDeploy"
        },
        {
          "$ref": "#/definitions/OperationsInstanceDelete"
        }
      ]
    },
    "OperationsCancellation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["actor", "expiresAt"],
      "properties": {
        "actor": {
          "$ref": "#/definitions/OperationsActor"
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "OperationsJobPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["jobs", "cursor"],
      "properties": {
        "jobs": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OperationsJob"
          }
        },
        "cursor": {
          "anyOf": [
            {
              "$ref": "#/definitions/OperationsCursor"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "OperationsLogRecord": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sequence", "at", "data", "clipped"],
      "properties": {
        "sequence": {
          "$ref": "#/definitions/OperationsCursor"
        },
        "at": {
          "type": "integer",
          "minimum": 0
        },
        "data": {
          "type": "string"
        },
        "clipped": {
          "type": "boolean"
        }
      }
    },
    "OperationsLogPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["entries", "cursor", "truncated"],
      "properties": {
        "entries": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OperationsLogRecord"
          }
        },
        "cursor": {
          "$ref": "#/definitions/OperationsCursor"
        },
        "truncated": {
          "type": "boolean"
        }
      }
    },
    "OperationsAlert": {
      "type": "string",
      "enum": [
        "process_stopped",
        "process_error",
        "log_storage_failed",
        "disk_pressure",
        "memory_pressure",
        "log_capture_loss"
      ]
    },
    "OperationsObservation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "observedAt",
        "uptimeSeconds",
        "instance",
        "cpuPercent",
        "memoryBytes",
        "diskTotalBytes",
        "diskAvailableBytes",
        "alerts"
      ],
      "properties": {
        "observedAt": {
          "type": "integer",
          "minimum": 0
        },
        "uptimeSeconds": {
          "type": "integer",
          "minimum": 0
        },
        "instance": {
          "$ref": "#/definitions/OperationsInstance"
        },
        "cpuPercent": {
          "anyOf": [
            {
              "type": "number",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "memoryBytes": {
          "anyOf": [
            {
              "type": "integer",
              "minimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "diskTotalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "diskAvailableBytes": {
          "type": "integer",
          "minimum": 0
        },
        "alerts": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/OperationsAlert"
          }
        }
      }
    },
    "OperationsCursor": {
      "type": "string",
      "pattern": "^[0-9]+$"
    },
    "OperationsPageQuery": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "$ref": "#/definitions/OperationsCursor"
        },
        "limit": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "OperationsSensitiveAction": {
      "type": "string",
      "enum": ["kill", "restore", "backup_delete", "deploy", "instance_delete", "provision"]
    },
    "OperationsKill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "pid"],
      "properties": {
        "action": {
          "enum": ["kill"]
        },
        "pid": {
          "type": "integer",
          "minimum": 1,
          "maximum": 4294967295
        }
      }
    },
    "OperationsHumanApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["account", "request", "approvedAt"],
      "properties": {
        "account": {
          "type": "string"
        },
        "request": {
          "$ref": "#/definitions/OperationsIdentifier"
        },
        "approvedAt": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "OperationsApproval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "host", "intent", "status", "expiresAt", "reviewUrl", "clientName"],
      "properties": {
        "id": {
          "$ref": "#/definitions/OperationsIdentifier"
        },
        "host": {
          "$ref": "#/definitions/OperationsIdentifier"
        },
        "intent": {
          "$ref": "#/definitions/OperationsIntent"
        },
        "status": {
          "enum": ["pending", "approved", "denied", "expired"]
        },
        "expiresAt": {
          "type": "integer",
          "minimum": 0
        },
        "reviewUrl": {
          "type": "string"
        },
        "clientName": {
          "type": ["string", "null"]
        },
        "preparation": {
          "$ref": "#/definitions/OperationsIntent"
        }
      }
    },
    "OperationsSubmissionResult": {
      "oneOf": [
        {
          "$ref": "#/definitions/OperationsJob"
        },
        {
          "$ref": "#/definitions/OperationsApproval"
        }
      ]
    },
    "OperationsClaim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id"],
      "properties": {
        "id": {
          "$ref": "#/definitions/OperationsIdentifier"
        }
      }
    },
    "OperationsBackupCreate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "label"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["backup"]
        },
        "label": {
          "$ref": "#/definitions/OperationsBackupLabel"
        }
      }
    },
    "OperationsRestore": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "archive", "preparation"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["restore"]
        },
        "archive": {
          "$ref": "#/definitions/OperationsIdentifier"
        },
        "preparation": {
          "$ref": "#/definitions/OperationsIdentifier"
        }
      }
    },
    "OperationsBackupExport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "archive"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["backup_export"]
        },
        "archive": {
          "$ref": "#/definitions/OperationsIdentifier"
        }
      }
    },
    "OperationsBackupImport": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "archive"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["backup_import"]
        },
        "archive": {
          "$ref": "#/definitions/OperationsIdentifier"
        }
      }
    },
    "OperationsBackupDelete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "archive"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["backup_delete"]
        },
        "archive": {
          "$ref": "#/definitions/OperationsIdentifier"
        }
      }
    },
    "OperationsBackup": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "instance", "label", "createdAt", "bytes", "expandedBytes", "files"],
      "properties": {
        "id": {
          "$ref": "#/definitions/OperationsIdentifier"
        },
        "instance": {
          "$ref": "#/definitions/OperationsIdentifier"
        },
        "label": {
          "$ref": "#/definitions/OperationsBackupLabel"
        },
        "createdAt": {
          "type": "integer",
          "minimum": 0
        },
        "bytes": {
          "type": "integer",
          "minimum": 0
        },
        "expandedBytes": {
          "type": "integer",
          "minimum": 0
        },
        "files": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "OperationsBackupPage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["backups"],
      "properties": {
        "backups": {
          "type": "array",
          "maxItems": 100,
          "items": {
            "$ref": "#/definitions/OperationsBackup"
          }
        }
      }
    },
    "OperationsResult": {
      "type": "object",
      "additionalProperties": false,
      "required": [],
      "properties": {
        "backup": {
          "$ref": "#/definitions/OperationsBackup"
        },
        "safetyArchive": {
          "$ref": "#/definitions/OperationsIdentifier"
        }
      }
    },
    "OperationsRestorePrepare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "archive"],
      "properties": {
        "action": {
          "type": "string",
          "enum": ["restore_prepare"]
        },
        "archive": {
          "$ref": "#/definitions/OperationsIdentifier"
        }
      }
    },
    "OperationsBackupLabel": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "OperationsFilePath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_./ -]*$"
    },
    "OperationsFileChange": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "text"],
          "properties": {
            "path": {
              "$ref": "#/definitions/OperationsFilePath"
            },
            "text": {
              "type": "string",
              "maxLength": 65536
            },
            "executable": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "url"],
          "properties": {
            "path": {
              "$ref": "#/definitions/OperationsFilePath"
            },
            "url": {
              "type": "string",
              "minLength": 1,
              "maxLength": 2048
            },
            "executable": {
              "type": "boolean"
            }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["path", "remove"],
          "properties": {
            "path": {
              "$ref": "#/definitions/OperationsFilePath"
            },
            "remove": {
              "enum": [true]
            }
          }
        }
      ]
    },
    "OperationsChanges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "$ref": "#/definitions/OperationsFileChange"
      }
    },
    "OperationsProvision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "profile", "autoStart", "changes"],
      "properties": {
        "action": {
          "enum": ["provision"]
        },
        "profile": {
          "$ref": "#/definitions/OperationsIdentifier"
        },
        "autoStart": {
          "type": "boolean"
        },
        "changes": {
          "$ref": "#/definitions/OperationsChanges"
        }
      }
    },
    "OperationsDeployPrepare": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "changes"],
      "properties": {
        "action": {
          "enum": ["deploy_prepare"]
        },
        "changes": {
          "$ref": "#/definitions/OperationsChanges"
        }
      }
    },
    "OperationsDeploy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "preparation"],
      "properties": {
        "action": {
          "enum": ["deploy"]
        },
        "preparation": {
          "$ref": "#/definitions/OperationsIdentifier"
        }
      }
    },
    "OperationsInstanceDelete": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action"],
      "properties": {
        "action": {
          "enum": ["instance_delete"]
        }
      }
    },
    "OperationsReservation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scope", "key"],
      "properties": {
        "scope": {
          "type": "string"
        },
        "key": {
          "$ref": "#/definitions/OperationsIdentifier"
        }
      }
    },
    "OperationsDefinition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "autoStart"],
      "properties": {
        "profile": {
          "$ref": "#/definitions/OperationsIdentifier"
        },
        "autoStart": {
          "type": "boolean"
        }
      }
    },
    "OperationsGlobalAction": {
      "type": "string",
      "enum": ["provision", "deploy_prepare", "deploy"]
    }
  }
}
