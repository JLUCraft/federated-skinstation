{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "esModuleInterop": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "vite/client"],
    "allowImportingTsExtensions": true
  },
  "include": ["server", "shared", "web", "test", "scripts", "vite.config.ts"]
}
