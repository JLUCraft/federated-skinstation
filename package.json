{
  "name": "@jlucraft/skin-station",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "contracts": "tsx scripts/generate-contracts.ts",
    "postinstall": "bun run contracts",
    "dev": "bun run contracts && tsx watch server/main.ts",
    "dev:web": "vite --host 127.0.0.1",
    "build": "bun run contracts && tsc --noEmit && vite build",
    "start": "bun run contracts && tsx server/main.ts",
    "test": "bun run contracts && tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.4",
    "@fastify/rate-limit": "^11.2.1",
    "@fastify/static": "^10.1.6",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.0.3",
    "fastify": "^5.12.7",
    "nodemailer": "^10.1.7",
    "pngjs": "^7.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "skinview-utils": "^0.7.1",
    "skinview3d": "^3.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/nodemailer": "^8.0.2",
    "@types/pngjs": "^6.0.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "json-schema-to-ts": "^3.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  }
}
